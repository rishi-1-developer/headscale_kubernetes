apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: headscale
  namespace: ${HEADSCALE_NAMESPACE}
  annotations:
    traefik.ingress.kubernetes.io/router.entrypoints: websecure
    traefik.ingress.kubernetes.io/router.tls: "true"
    traefik.ingress.kubernetes.io/router.tls.certresolver: letsencrypt
spec:
  ingressClassName: ${INGRESS_CLASS_NAME}
  tls:
    - hosts: [${HEADSCALE_HOST}, ${HEADPLANE_HOST}]
  rules:
    - host: ${HEADSCALE_HOST}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend: { service: { name: headscale, port: { number: 8080 } } }
    - host: ${HEADPLANE_HOST}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend: { service: { name: headplane, port: { number: 3000 } } }
