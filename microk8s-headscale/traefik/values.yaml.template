deployment:
  replicas: 1

providers:
  kubernetesCRD:
    enabled: true
    allowCrossNamespace: true
  kubernetesIngress:
    enabled: false

additionalArguments:
  - --entrypoints.web.address=:80/tcp
  - --entrypoints.websecure.address=:443/tcp
  - --entrypoints.derp-stun.address=:3478/udp
  - --certificatesresolvers.letsencrypt.acme.email=${LETSENCRYPT_EMAIL}
  - --certificatesresolvers.letsencrypt.acme.storage=/data/acme.json
  - --certificatesresolvers.letsencrypt.acme.httpchallenge.entrypoint=web

ports:
  web:
    port: 80
    hostPort: 80
    exposedPort: 80
    protocol: TCP
    expose:
      default: true
  websecure:
    port: 443
    hostPort: 443
    exposedPort: 443
    protocol: TCP
    expose:
      default: true
  derp-stun:
    port: 3478
    hostPort: 3478
    expose:
      default: true
    exposedPort: 3478
    protocol: UDP

persistence:
  enabled: true
  storageClass: microk8s-hostpath
  accessMode: ReadWriteOnce
  size: 1Gi

tlsStore:
  default:
    defaultCertificate:
      secretName: bitvivid-default-tls

service:
  type: ClusterIP
