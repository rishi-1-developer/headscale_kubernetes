HEADSCALE_NAMESPACE=headscale
INGRESS_CLASS_NAME=nginx
TLS_SECRET_NAME=headscale-tls
# Optional existing TLS certificate files for the Ingress Secret.
# TLS_CERT_FILE=/opt/bitvivid-ca/traefik-server.crt
# TLS_KEY_FILE=/opt/bitvivid-ca/traefik-server.key
HEADSCALE_IMAGE=ghcr.io/juanfont/headscale:0.26.1
HEADPLANE_IMAGE=ghcr.io/tale/headplane:0.6.1
HEADSCALE_HOST=hs1.bitvividsolutions.com
HEADPLANE_HOST=hp1.bitvividsolutions.com
HEADSCALE_DB_HOST=127.0.0.1
HEADSCALE_DB_PORT=5432
HEADSCALE_DB_NAME=headscale
HEADSCALE_DB_USER=headscale
# Add these only to the real .env:
# HEADSCALE_DB_PASSWORD=
# HEADPLANE_COOKIE_SECRET=
# HEADSCALE_API_KEY=
